<mxfile host="app.diagrams.net" modified="2026-11-03" type="device">
  <diagram id="observer-class" name="Observer - Class Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Observer Pattern — Class Diagram&lt;/b&gt;&lt;br&gt;Mẫu Observer: thông báo bất đồng bộ khi trạng thái lịch hẹn thay đổi" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="520" height="50" as="geometry"/>
        </mxCell>

        <!-- Subject: ApplicationEventPublisher (Spring) -->
        <mxCell id="publisher" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;ApplicationEventPublisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Spring Framework)&lt;/i&gt;&lt;hr&gt;&lt;hr&gt;+ publishEvent(event: Object): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- Concrete Subject: AsyncEmailNotificationServiceImpl -->
        <mxCell id="subject" value="&lt;b&gt;AsyncEmailNotificationServiceImpl&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Concrete Subject)&lt;/i&gt;&lt;hr&gt;- eventPublisher: ApplicationEventPublisher&lt;hr&gt;+ sendBookingConfirmation(Appointment): void&lt;br&gt;+ sendCancellationNotice(Appointment): void&lt;br&gt;+ sendAppointmentReminder(Appointment): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="380" height="150" as="geometry"/>
        </mxCell>

        <!-- Event -->
        <mxCell id="event" value="&lt;b&gt;&amp;lt;&amp;lt;record&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;EmailNotificationRequestedEvent&lt;/b&gt;&lt;hr&gt;- message: EmailNotificationMessage&lt;hr&gt;+ message(): EmailNotificationMessage" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="340" height="110" as="geometry"/>
        </mxCell>

        <!-- Event Data -->
        <mxCell id="event_data" value="&lt;b&gt;&amp;lt;&amp;lt;record&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;EmailNotificationMessage&lt;/b&gt;&lt;hr&gt;- type: String&lt;br&gt;- recipientEmail: String&lt;br&gt;- patientName: String&lt;br&gt;- bookingCode: String&lt;br&gt;- doctorName: String&lt;br&gt;- workDate, startTime, endTime: String&lt;br&gt;- price: String" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="240" height="180" as="geometry"/>
        </mxCell>

        <!-- Observer 1: EmailQueuePublisher (production) -->
        <mxCell id="obs1" value="&lt;b&gt;EmailQueuePublisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Observer — @Profile(&quot;!demo&quot;))&lt;/i&gt;&lt;hr&gt;- rabbitTemplate: RabbitTemplate&lt;hr&gt;+ onNotificationRequested(event)&lt;br&gt;&amp;nbsp;&amp;nbsp;@TransactionalEventListener&lt;br&gt;&amp;nbsp;&amp;nbsp;(phase = AFTER_COMMIT)&lt;br&gt;&amp;nbsp;&amp;nbsp;@Async" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="320" width="310" height="150" as="geometry"/>
        </mxCell>

        <!-- Observer 2: DemoNotificationObserver (demo) -->
        <mxCell id="obs2" value="&lt;b&gt;DemoNotificationObserver&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Observer — @Profile(&quot;demo&quot;))&lt;/i&gt;&lt;hr&gt;- emailQueueConsumer: EmailQueueConsumer&lt;hr&gt;+ onNotificationRequested(event)&lt;br&gt;&amp;nbsp;&amp;nbsp;@TransactionalEventListener&lt;br&gt;&amp;nbsp;&amp;nbsp;(phase = AFTER_COMMIT)&lt;br&gt;&amp;nbsp;&amp;nbsp;@Async" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="320" width="320" height="150" as="geometry"/>
        </mxCell>

        <!-- Consumer (downstream) -->
        <mxCell id="consumer" value="&lt;b&gt;EmailQueueConsumer&lt;/b&gt;&lt;hr&gt;- creators: NotificationCreatorRegistry&lt;br&gt;- sender: NotificationSender&lt;hr&gt;+ consume(EmailNotificationMessage): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="550" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- Relationships -->
        <!-- Subject uses Publisher -->
        <mxCell id="rel1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="subject" target="publisher" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel1_label" value="publishes via" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel1">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Subject creates Event -->
        <mxCell id="rel2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="subject" target="event" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel2_label" value="&amp;lt;&amp;lt;creates&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel2">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Event contains Message -->
        <mxCell id="rel_ev" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=diamondThin;endFill=1;strokeWidth=1.5;" edge="1" source="event_data" target="event" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Observer 1 listens to event -->
        <mxCell id="rel3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="obs1" target="event" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel3_label" value="&amp;lt;&amp;lt;listens&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Observer 2 listens to event -->
        <mxCell id="rel4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="obs2" target="event" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel4_label" value="&amp;lt;&amp;lt;listens&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel4">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Observer 1 -> Consumer (via RabbitMQ) -->
        <mxCell id="rel5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="obs1" target="consumer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel5_label" value="RabbitMQ" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel5">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Observer 2 -> Consumer (direct) -->
        <mxCell id="rel6" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="obs2" target="consumer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel6_label" value="trực tiếp" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel6">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Note -->
        <mxCell id="note1" value="Chỉ 1 Observer hoạt động tại mỗi thời điểm,&lt;br&gt;phụ thuộc Spring profile đang chạy.&lt;br&gt;Cả hai đều chạy AFTER_COMMIT + @Async&lt;br&gt;→ không gửi thông báo nếu giao dịch rollback." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=11;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1060" y="120" width="310" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
