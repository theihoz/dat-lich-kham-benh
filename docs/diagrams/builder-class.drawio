        <!-- AppointmentBuilder inner class -->
        <mxCell id="bld-box" value="&lt;b&gt;Appointment.AppointmentBuilder&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;startSize=26;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="320" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="bld-attrs" value="- id: Long&#xa;- bookingCode: String&#xa;- patient: Patient&#xa;- doctor: Doctor&#xa;- schedule: Schedule&#xa;- symptoms: String&#xa;- status: String&#xa;- price: BigDecimal&#xa;- createdAt: LocalDateTime" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;" vertex="1" parent="bld-box">
