        <mxCell id="comp-edge" style="endArrow=diamondThin;endFill=1;endSize=14;startArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="bld-box" target="apt-box" parent="1">
