        <!-- Note -->
        <mxCell id="note1" value="Builder Pattern&#xa;───────────&#xa;Xây dựng đối tượng Appointment phức tạp&#xa;từng bước qua các phương thức fluent,&#xa;tách quá trình khởi tạo khỏi biểu diễn." style="shape=note;size=15;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1">
