<mxfile host="app.diagrams.net" modified="2026-11-03" type="device">
  <diagram id="facade-class" name="Facade - Class Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Facade Pattern — Class Diagram&lt;/b&gt;&lt;br&gt;Mẫu Facade: cung cấp giao diện đơn giản cho hệ thống con đặt lịch" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="50" as="geometry"/>
        </mxCell>

        <!-- Client: BookingController -->
        <mxCell id="client" value="&lt;b&gt;BookingController&lt;/b&gt;&lt;hr&gt;- bookingFacade: AppointmentBookingFacade&lt;br&gt;- bookingService: BookingService&lt;br&gt;- currentUserService: CurrentUserService&lt;hr&gt;+ createBooking(UserDetails, CreateBookingDto): ResponseEntity&lt;br&gt;+ cancelBooking(UserDetails, Long): ResponseEntity" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="420" height="150" as="geometry"/>
        </mxCell>

        <!-- Facade Interface -->
        <mxCell id="facade_iface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;AppointmentBookingFacade&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;+ bookAppointment(Long, CreateBookingDto): AppointmentDto&lt;br&gt;+ cancelAppointment(Long, Long): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="550" y="120" width="400" height="130" as="geometry"/>
        </mxCell>

        <!-- Facade Impl -->
        <mxCell id="facade_impl" value="&lt;b&gt;AppointmentBookingFacadeImpl&lt;/b&gt;&lt;hr&gt;- bookingService: BookingService&lt;br&gt;- doctorScheduleService: DoctorScheduleService&lt;hr&gt;+ bookAppointment(Long, CreateBookingDto): AppointmentDto&lt;br&gt;+ cancelAppointment(Long, Long): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="550" y="320" width="400" height="150" as="geometry"/>
        </mxCell>

        <!-- Subsystem boundary -->
        <mxCell id="subsystem_box" value="&lt;b&gt;Hệ thống con (Subsystem)&lt;/b&gt;" style="shape=mxgraph.uml25.package;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;spacingTop=5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="530" width="900" height="200" as="geometry"/>
        </mxCell>

        <!-- Subsystem: BookingService -->
        <mxCell id="booking_svc" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;BookingService&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;+ createBooking(Long, CreateBookingDto): AppointmentDto&lt;br&gt;+ cancelBooking(Long, Long): void&lt;br&gt;+ getPatientAppointments(Long): List&lt;br&gt;+ getBookingDetails(...): AppointmentDto&lt;br&gt;+ updateAppointmentStatus(...): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="570" width="380" height="140" as="geometry"/>
        </mxCell>

        <!-- Subsystem: DoctorScheduleService -->
        <mxCell id="schedule_svc" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;DoctorScheduleService&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;+ getAvailableSlots(Long, LocalDate): List&lt;br&gt;+ createSlot(Long, CreateScheduleDto): ScheduleDto&lt;br&gt;+ toggleSlotAvailability(...): void" style="shape=mxgraph.uml25.class;whiteSpace=wrap;html=1;align=left;spacingLeft=5;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="570" width="380" height="130" as="geometry"/>
        </mxCell>

        <!-- Relationships -->
        <!-- Client depends on Facade (dashed arrow) -->
        <mxCell id="rel1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="client" target="facade_iface" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel1_label" value="&amp;lt;&amp;lt;uses&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel1">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Impl implements Interface (dashed arrow with triangle) -->
        <mxCell id="rel2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=0;strokeWidth=1.5;" edge="1" source="facade_impl" target="facade_iface" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel2_label" value="&amp;lt;&amp;lt;implements&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel2">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Facade delegates to BookingService -->
        <mxCell id="rel3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="facade_impl" target="booking_svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel3_label" value="&amp;lt;&amp;lt;delegates&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Facade delegates to DoctorScheduleService -->
        <mxCell id="rel4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" source="facade_impl" target="schedule_svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel4_label" value="&amp;lt;&amp;lt;delegates&amp;gt;&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel4">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Note -->
        <mxCell id="note1" value="Facade ẩn đi sự phức tạp của hệ thống con.&lt;br&gt;Controller chỉ cần gọi 2 phương thức của Facade&lt;br&gt;thay vì phải biết chi tiết từng service." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=11;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="130" width="300" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
