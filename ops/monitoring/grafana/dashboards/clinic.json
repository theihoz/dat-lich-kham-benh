{
  "uid": "clinic-operations",
  "title": "Clinic operations",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Mean latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.01)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Outbox pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "clinic_notifications_outbox_pending",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Outbox dead",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "clinic_notifications_outbox_dead",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Last backup age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "targets": [
        {
          "expr": "time() - clinic_backup_last_success_unixtime",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
